---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact Us">
  <div
    id="contact-page"
    class="pt-28 pb-24 bg-white text-neutral-900 min-h-screen"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <p
          class="text-xs sm:text-sm font-bold tracking-[0.25em] text-[#1a2644] uppercase"
        >
          — HUBUNGI GARIS AS STUDIO
        </p>

        <h1
          class="text-3xl sm:text-5xl font-extrabold font-display text-neutral-950 tracking-tight"
        >
          Mari Mulai Berdiskusi
        </h1>

        <p class="text-sm sm:text-base text-neutral-600">
          Kunjungi studio kami atau langsung hubungi arsitek kami via WhatsApp
          untuk konsultasi denah, fasad kayu, dan estimasi proyek rumah tinggal.
        </p>
      </div>

      <!-- Contact Information & WhatsApp Action Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        <!-- Left: Office Locations -->
        <div class="lg:col-span-5 space-y-6">
          <!-- Main Studio -->
          <div
            class="p-6 bg-neutral-50 rounded-xs border border-neutral-200/80 space-y-4"
          >
            <div
              class="flex items-center justify-between border-b border-neutral-200 pb-3"
            >
              <h3
                class="font-bold text-base uppercase font-display text-neutral-900"
              >
                Garis AS Studio Headquarters
              </h3>

              <span
                class="text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 bg-[#121b30] text-white"
              >
                Main Studio
              </span>
            </div>

            <div class="space-y-3 text-xs sm:text-sm text-neutral-700">
              <div class="flex items-start gap-3">
                <svg
                  class="w-4 h-4 text-[#1a2644] shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 21s8-4.5 8-10a8 8 0 1 0-16 0c0 5.5 8 10 8 10z"
                  ></path>
                  <circle cx="12" cy="11" r="2.5"></circle>
                </svg>

                <span>
                  Jl. Senopati Raya No. 28, Kebayoran Baru, Jakarta Selatan
                  12190
                </span>
              </div>

              <div class="flex items-center gap-3">
                <svg
                  class="w-4 h-4 text-[#1a2644] shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M22 16.92v3a2 2 0 0 1-2.18 2
                  19.79 19.79 0 0 1-8.63-3.07
                  19.5 19.5 0 0 1-6-6
                  19.79 19.79 0 0 1-3.07-8.67
                  A2 2 0 0 1 4.11 2h3
                  a2 2 0 0 1 2 1.72
                  12.84 12.84 0 0 0 .7 2.81
                  2 2 0 0 1-.45 2.11L8.09 9.91
                  a16 16 0 0 0 6 6l1.27-1.27
                  a2 2 0 0 1 2.11-.45
                  12.84 12.84 0 0 0 2.81.7
                  A2 2 0 0 1 22 16.92z"
                  ></path>
                </svg>

                <span>+62 812-3456-7890 / +62 (21) 7288 1902</span>
              </div>

              <div class="flex items-center gap-3">
                <svg
                  class="w-4 h-4 text-[#1a2644] shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.5 5.5a2.5 2.5 0 0 1-3 0L2 7"></path>
                </svg>

                <span>halo@garisasstudio.com</span>
              </div>

              <div class="flex items-center gap-3">
                <svg
                  class="w-4 h-4 text-[#1a2644] shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M12 7v5l3 2"></path>
                </svg>

                <span>Senin - Sabtu: 09.00 - 18.00 WIB</span>
              </div>
            </div>
          </div>

          <!-- Bali Studio -->
          <div
            class="p-6 bg-neutral-50 rounded-xs border border-neutral-200/80 space-y-4"
          >
            <div
              class="flex items-center justify-between border-b border-neutral-200 pb-3"
            >
              <h3
                class="font-bold text-base uppercase font-display text-neutral-900"
              >
                Bali Workshop & Design Gallery
              </h3>

              <span
                class="text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 bg-neutral-200 text-neutral-800"
              >
                By Appointment
              </span>
            </div>

            <div class="space-y-3 text-xs sm:text-sm text-neutral-700">
              <div class="flex items-start gap-3">
                <svg
                  class="w-4 h-4 text-[#1a2644] shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 21s8-4.5 8-10a8 8 0 1 0-16 0c0 5.5 8 10 8 10z"
                  ></path>
                  <circle cx="12" cy="11" r="2.5"></circle>
                </svg>

                <span>
                  Jl. Sunset Road No. 88, Seminyak, Kuta, Bali 80361
                </span>
              </div>

              <div class="flex items-center gap-3">
                <svg
                  class="w-4 h-4 text-[#1a2644] shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M22 16.92v3a2 2 0 0 1-2.18 2
                  19.79 19.79 0 0 1-8.63-3.07
                  19.5 19.5 0 0 1-6-6
                  19.79 19.79 0 0 1-3.07-8.67
                  A2 2 0 0 1 4.11 2h3
                  a2 2 0 0 1 2 1.72
                  12.84 12.84 0 0 0 .7 2.81
                  2 2 0 0 1-.45 2.11L8.09 9.91
                  a16 16 0 0 0 6 6l1.27-1.27
                  a2 2 0 0 1 2.11-.45
                  12.84 12.84 0 0 0 2.81.7
                  A2 2 0 0 1 22 16.92z"
                  ></path>
                </svg>

                <span>+62 (361) 8499 123</span>
              </div>

              <div class="flex items-center gap-3">
                <svg
                  class="w-4 h-4 text-[#1a2644] shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.5 5.5a2.5 2.5 0 0 1-3 0L2 7"></path>
                </svg>

                <span>project@garisasstudio.com</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: WhatsApp -->
        <div
          class="lg:col-span-7 bg-[#121b30] text-white p-8 sm:p-10 rounded-xs space-y-8 flex flex-col justify-between"
        >
          <div class="space-y-6">
            <div class="space-y-2 border-b border-white/10 pb-5">
              <div
                class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-500/10 border border-emerald-500/30 rounded-xs text-[11px] font-bold uppercase tracking-wider text-emerald-400"
              >
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"
                ></span>
                <span>KONSULTASI LANGSUNG DENGAN ARSITEK</span>
              </div>

              <h3
                class="text-2xl sm:text-3xl font-bold font-display uppercase tracking-wide text-white"
              >
                Kirim Pesan WhatsApp
              </h3>

              <p class="text-sm text-neutral-300 leading-relaxed">
                Tidak perlu mengisi formulir panjang. Dapatkan respon cepat dan
                panduan langsung dari tim arsitek Garis AS Studio melalui pesan
                WhatsApp resmi kami.
              </p>
            </div>

            <!-- Primary WhatsApp -->
            <div class="space-y-3">
              <a
                href="https://wa.me/6281234567890?text=Halo%20Garis%20AS%20Studio%2C%20saya%20ingin%20mendiskusikan%20rancangan%20arsitektur%20rumah%20tinggal%20bernuansa%20kayu%20modern."
                target="_blank"
                rel="noopener noreferrer"
                class="w-full py-4.5 px-6 bg-[#25D366] hover:bg-[#20ba5a] text-black font-extrabold text-sm sm:text-base uppercase tracking-[0.2em] rounded-xs transition-all duration-300 flex items-center justify-center gap-3 shadow-xl hover:scale-[1.01] active:scale-[0.99]"
              >
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                  <path
                    d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.159.57 4.187 1.564 5.945l-1.663 6.077 6.221-1.632c1.701.928 3.649 1.454 5.722 1.454 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12zm0 21.84c-1.892 0-3.666-.549-5.163-1.492l-.37-.234-3.699.97 1.002-3.661-.247-.393c-1.042-1.654-1.643-3.612-1.643-5.71 0-5.421 4.419-9.84 9.84-9.84s9.84 4.419 9.84 9.84c0 5.421-4.419 9.84-9.84 9.84z"
                  ></path>
                </svg>

                <span>CHAT WHATSAPP ARSITEK GARIS AS</span>
              </a>

              <p class="text-center text-[11px] text-neutral-400">
                Nomor Resmi: +62 812-3456-7890 (Online Setiap Hari)
              </p>
            </div>

            <!-- Quick Topics -->
            <div class="space-y-3 pt-2">
              <p
                class="text-xs font-bold uppercase tracking-wider text-neutral-400"
              >
                Pilihan Topik Diskusi Cepat:
              </p>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                <!-- Rencana Desain -->
                <a
                  href="https://wa.me/6281234567890?text=Halo%20Garis%20AS%20Studio%2C%20saya%20ingin%20berkonsultasi%20mengenai%20Desain%20%26%20Denah%20Rumah%20Kayu%20Modern."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-3 bg-[#0a0f1d] hover:bg-[#18233f] border border-neutral-700/80 hover:border-amber-300/60 rounded-xs text-left transition-all group"
                >
                  <span
                    class="block text-xs font-bold text-white group-hover:text-amber-300"
                  >
                    Rencana Desain
                  </span>

                  <span
                    class="text-[11px] text-neutral-400 flex items-center gap-1 mt-1"
                  >
                    Denah & fasad
                    <span class="group-hover:translate-x-1 transition-transform"
                      >→</span
                    >
                  </span>
                </a>

                <!-- Estimasi Biaya -->
                <a
                  href="https://wa.me/6281234567890?text=Halo%20Garis%20AS%20Studio%2C%20saya%20ingin%20berkonsultasi%20mengenai%20Estimasi%20Biaya%20%26%20Struktur%20Kayu%20Jati%2FUlin%2FMerbau."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-3 bg-[#0a0f1d] hover:bg-[#18233f] border border-neutral-700/80 hover:border-amber-300/60 rounded-xs text-left transition-all group"
                >
                  <span
                    class="block text-xs font-bold text-white group-hover:text-amber-300"
                  >
                    Estimasi Biaya
                  </span>

                  <span
                    class="text-[11px] text-neutral-400 flex items-center gap-1 mt-1"
                  >
                    RAB & material
                    <span class="group-hover:translate-x-1 transition-transform"
                      >→</span
                    >
                  </span>
                </a>

                <!-- Jadwal Diskusi -->
                <a
                  href="https://wa.me/6281234567890?text=Halo%20Garis%20AS%20Studio%2C%20saya%20ingin%20berkonsultasi%20mengenai%20Jadwal%20Pertemuan%20%2F%20Konsultasi%20Daring%20Zoom."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-3 bg-[#0a0f1d] hover:bg-[#18233f] border border-neutral-700/80 hover:border-amber-300/60 rounded-xs text-left transition-all group"
                >
                  <span
                    class="block text-xs font-bold text-white group-hover:text-amber-300"
                  >
                    Jadwal Diskusi
                  </span>

                  <span
                    class="text-[11px] text-neutral-400 flex items-center gap-1 mt-1"
                  >
                    Studio / Online
                    <span class="group-hover:translate-x-1 transition-transform"
                      >→</span
                    >
                  </span>
                </a>
              </div>
            </div>
          </div>

          <!-- Email Alternative -->
          <div
            class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-neutral-400"
          >
            <span>Pertanyaan melalui email:</span>

            <a
              href="mailto:halo@garisasstudio.com"
              class="text-amber-300 font-bold hover:underline flex items-center gap-1.5"
            >
              <span>✉</span>
              <span>halo@garisasstudio.com</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
