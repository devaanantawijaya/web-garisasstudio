---
import { FaInstagram } from "react-icons/fa";
import { FiYoutube, FiPhone, FiMail } from "react-icons/fi";
import { LuMapPin } from "react-icons/lu";
import { GarisAsLogo } from "../react-components/GarisAsLogo";

const { brandName, logo } = Astro.props;
---

<footer
  id="main-footer"
  class="bg-[#0e121e] text-white pt-16 pb-12 border-t border-neutral-800/80"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 pb-14 border-b border-neutral-800"
    >
      {/* Brand & Studio Summary */}
      <div class="lg:col-span-4 space-y-5">
        <a href="/" class="text-left focus:outline-none block">
          <GarisAsLogo
            brandName={brandName}
            logo={logo}
            size="md"
            inverted={true}
          />
        </a>

        <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed">
          Studio arsitektur & desain interior yang berfokus menciptakan desain
          rumah tinggal modern dengan kehangatan elemen kayu alami, proporsi
          ruang yang tenang, dan pencahayaan bernuansa tropis.
        </p>

        {/* Social as */}
        <div class="flex items-center space-x-3 pt-2">
          <a
            href="https://www.instagram.com/garis.asstudio/"
            target="_blank"
            rel="noreferrer"
            class="w-9 h-9 rounded-xs bg-[#16223b] border border-white/10 hover:border-white hover:text-white text-neutral-300 flex items-center justify-center transition-colors"
            aria-label="Instagram Garis AS Studio"
          >
            <FaInstagram class="w-4 h-4" />
          </a>

          <a
            href="https://www.youtube.com/@garisasstudio6082"
            target="_blank"
            rel="noreferrer"
            class="w-9 h-9 rounded-xs bg-[#16223b] border border-white/10 hover:border-white hover:text-white text-neutral-300 flex items-center justify-center transition-colors"
            aria-label="YouTube Garis AS Studio"
          >
            <FiYoutube class="w-4 h-4" />
          </a>

          <a
            href="https://www.tiktok.com/@janadipertama?_r=1&_t=ZS-99Z7aLDz2Y8"
            target="_blank"
            rel="noreferrer"
            class="w-9 h-9 rounded-xs bg-[#16223b] border border-white/10 hover:border-white hover:text-white text-neutral-300 flex items-center justify-center transition-colors"
            aria-label="TikTok Garis AS Studio"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path
                d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.68 6.34 6.34 0 0 0 9.33 22a6.34 6.34 0 0 0 6.34-6.32V8.2a8.3 8.3 0 0 0 4.92 1.63V6.38a4.85 4.85 0 0 1-1-.09z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      {/* Nav */}
      <div class="lg:col-span-2 space-y-4">
        <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-white">
          Navigasi
        </h4>

        <ul
          class="space-y-2.5 text-xs text-neutral-400 font-semibold uppercase tracking-wider"
        >
          <li>
            <a href="/" class="hover:text-white transition-colors block">
              Home
            </a>
          </li>

          <li>
            <a
              href="/portfolio"
              class="hover:text-white transition-colors block"
            >
              Portofolio
            </a>
          </li>

          <li>
            <a href="/about" class="hover:text-white transition-colors block">
              Tentang Kami
            </a>
          </li>

          <li>
            <a href="/contact" class="hover:text-white transition-colors block">
              Kontak
            </a>
          </li>
        </ul>
      </div>

      {/* Kategori Proyek / Layanan */}
      <div class="lg:col-span-3 space-y-4">
        <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-white">
          Layanan Utama
        </h4>

        <ul class="space-y-2 text-xs text-neutral-400">
          <li>Desain Rumah Tinggal Modern Kayu</li>

          <li>Arsitektur Fasad Kisi-kisi Kayu Alami</li>

          <li>Interior Living & Master Suite Bernuansa Hangat</li>

          <li>Custom Timber Millwork & Perabot Kayu</li>

          <li>Vila & Paviliun Hunian Tropis Modern</li>
        </ul>
      </div>

      {/* Contact Details */}
      <div class="lg:col-span-3 space-y-4">
        <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-white">
          Studio & Workshop
        </h4>

        <div class="space-y-2.5 text-xs text-neutral-400">
          <p class="flex items-start gap-2">
            <LuMapPin class="w-4 h-4 text-neutral-500 shrink-0 mt-0.5" />

            <span> Denpasar, Bali </span>
          </p>

          <p class="flex items-center gap-2">
            <FiPhone class="w-4 h-4 text-neutral-500 shrink-0" />

            <span> +62 859-3524-0450 </span>
          </p>

          <p class="flex items-center gap-2">
            <FiMail class="w-4 h-4 text-neutral-500 shrink-0" />

            <span> partamajanadi@gmail.com </span>
          </p>
        </div>
      </div>
    </div>

    {/* Bottom Copyright */}
    <div
      class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-neutral-500 gap-4"
    >
      <p>
        © {new Date().getFullYear()} Garis AS Studio. Hak Cipta Dilindungi Undang-Undang.
      </p>

      <div class="flex items-center space-x-6 text-[11px]">
        <span class="hover:text-neutral-400 cursor-pointer">
          Kebijakan Privasi
        </span>

        <span>•</span>

        <span class="hover:text-neutral-400 cursor-pointer">
          Syarat & Ketentuan
        </span>
      </div>
    </div>
  </div>
</footer>
