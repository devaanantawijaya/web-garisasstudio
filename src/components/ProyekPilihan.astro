---
import { ArrowRight } from "lucide-react";
const { projects } = Astro.props;
---

<section
  id="proyek-pilihan-section"
  class="py-20 sm:py-24 bg-white text-neutral-900"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Section Header */}
    <div class="text-center space-y-2 mb-12 sm:mb-14">
      <p
        class="text-xs sm:text-sm font-bold tracking-[0.25em] text-neutral-600 uppercase flex items-center justify-center gap-2"
      >
        <span>—</span>
        <span>KARYA KAMI</span>
      </p>
      <h2
        id="proyek-pilihan-title"
        class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-neutral-950 font-display tracking-tight"
      >
        Proyek Pilihan
      </h2>
    </div>

    {/* 6 Projects Grid (2x3 on desktop) */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {
        projects.slice(0, 6).map((project) => (
          <div
            key={project.id}
            class="group relative overflow-hidden bg-neutral-100 rounded-xs shadow-xs transition-all duration-500 ease-out hover:-translate-y-1.5 hover:shadow-xl"
          >
            <a
              href={`/portfolio/${project.id}`}
              class="block relative w-full h-full focus:outline-none"
            >
              {/* Image Container with Aspect Ratio */}
              <div class="relative aspect-[4/3] w-full overflow-hidden">
                <img
                  src={project.heroImage.src || project.heroImage}
                  alt={project.title}
                  class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-108"
                  loading="lazy"
                  referrerPolicy="no-referrer"
                />

                {/* Gradient Overlay for Text Readability */}
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-85 group-hover:opacity-95 transition-opacity duration-300" />

                {/* Top Category Badge */}
                <div class="absolute top-4 left-4 z-10">
                  <span class="px-2.5 py-1 text-[10px] font-bold tracking-widest uppercase bg-black/60 backdrop-blur-xs text-white border border-white/20">
                    {project.category}
                  </span>
                </div>

                {/* Bottom Text Content */}
                <div class="absolute bottom-0 left-0 right-0 p-5 z-10 text-white flex flex-col justify-end">
                  <div class="space-y-1">
                    <h3 class="text-lg sm:text-xl font-bold uppercase tracking-wide font-display text-white group-hover:text-amber-200 transition-colors">
                      {project.title}
                    </h3>
                    <div class="flex items-center gap-2 text-xs font-medium text-neutral-300 uppercase tracking-wider">
                      <span>{project.location}</span>
                      <span>•</span>
                      <span>{project.year}</span>
                    </div>
                  </div>

                  {/* Hover detail indicator */}
                  <div class="mt-3 pt-2 border-t border-white/20 flex items-center justify-between opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <span class="text-[11px] font-bold tracking-wider uppercase text-white/90">
                      Lihat Detail Proyek
                    </span>
                    <ArrowRight class="w-4 h-4 text-white transform group-hover:translate-x-1 transition-transform" />
                  </div>
                </div>
              </div>
            </a>
          </div>
        ))
      }
    </div>

    {
      /* Bottom CTA: "Lihat Portofolio Lainnya" (Directs to portfolio page via a) */
    }
    <div class="mt-14 sm:mt-16 text-center">
      <a
        id="view-all-portfolio-btn"
        href="/portfolio"
        class="group inline-flex items-center gap-3 px-8 py-4 bg-neutral-900 hover:bg-neutral-800 text-white text-xs sm:text-sm font-bold uppercase tracking-[0.2em] rounded-xs transition-all duration-300 shadow-md hover:shadow-lg focus:outline-none"
      >
        <span>LIHAT PORTOFOLIO LAINNYA</span>

        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-2"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
