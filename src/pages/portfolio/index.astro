---
import Layout from "../../layouts/Layout.astro";
import { CATEGORIES, PROJECTS } from "../../data/projects";
---

<Layout title="Portfolio Kami">
  <div
    id="portfolio-page"
    class="pt-28 pb-24 bg-white text-neutral-900 min-h-screen"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Page Header -->
      <div class="mb-10 text-center max-w-3xl mx-auto space-y-3">
        <p class="text-xs sm:text-sm font-bold tracking-[0.25em] text-neutral-400 uppercase">
          — KATALOG ARSITEKTUR
        </p>

        <h1 class="text-3xl sm:text-5xl font-extrabold font-display text-neutral-950 tracking-tight">
          Portfolio Karya Kami
        </h1>

        <p class="text-sm sm:text-base text-neutral-500 leading-relaxed">
          Kumpulan karya arsitektur tropis, vila mewah, apartemen,
          hotel butik, dan desain interior eksklusif yang dirancang
          dengan presisi estetika dan fungsionalitas di Bali.
        </p>
      </div>

      <!-- Search & Filter Bar -->
      <div class="mb-8 flex flex-col md:flex-row items-center justify-between gap-4 bg-neutral-50 p-4 rounded-xs border border-neutral-200/80">

        <!-- Search -->
        <div class="relative w-full md:w-80">
          <svg
            class="w-4 h-4 text-neutral-400 absolute left-3.5 top-1/2 -translate-y-1/2"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m21 21-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"
            />
          </svg>

          <input
            id="portfolio-search"
            type="text"
            placeholder="Cari nama proyek, lokasi, vila..."
            class="w-full pl-10 pr-4 py-2 bg-white border border-neutral-200 rounded-xs text-xs sm:text-sm focus:outline-none focus:border-neutral-900 text-neutral-900 placeholder-neutral-400"
          />
        </div>

        <div class="text-xs font-semibold text-neutral-500">
          Menampilkan
          <span id="project-count" class="font-bold text-neutral-900">
            {PROJECTS.length}
          </span>
          dari {PROJECTS.length} Proyek
        </div>
      </div>

      <!-- Categories -->
      <div
        id="portfolio-categories"
        class="flex items-center justify-start overflow-x-auto no-scrollbar gap-3 sm:gap-5 pb-4 mb-10 border-b border-neutral-200"
      >
        {CATEGORIES.map((cat) => (
          <button
            type="button"
            data-category={cat}
            class:list={[
              "portfolio-category relative pb-2.5 text-xs sm:text-sm font-bold uppercase tracking-wider whitespace-nowrap transition-colors cursor-pointer",
              cat === "KARYA PILIHAN"
                ? "text-neutral-950 active"
                : "text-neutral-500 hover:text-neutral-800",
            ]}
          >
            {cat}

            <span
              class:list={[
                "category-indicator absolute bottom-0 left-0 right-0 h-[2px] bg-neutral-900",
                cat === "KARYA PILIHAN" ? "block" : "hidden",
              ]}
            />
          </button>
        ))}
      </div>

      <!-- Projects -->
      <div
        id="projects-grid"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
      >
        {PROJECTS.map((project) => (
          <article
            class="project-card group bg-white border border-neutral-200/80 rounded-xs overflow-hidden shadow-xs hover:shadow-md transition-all flex flex-col"
            data-title={project.title}
            data-location={project.location}
            data-category={project.category}
            data-categories={project.categories?.join(",") || ""}
            data-client={project.client}
          >

            <!-- Image -->
            <a
              href={`/portfolio/${project.slug || project.id}`}
              class="block focus:outline-none"
            >
              <div class="relative aspect-[4/3] overflow-hidden bg-neutral-100">

                <img
                  src={project.heroImage.src || project.heroImage}
                  alt={project.title}
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  loading="lazy"
                  referrerpolicy="no-referrer"
                />

                <div class="absolute top-3 left-3">
                  <span class="px-2.5 py-1 text-[10px] font-bold tracking-wider uppercase bg-black/70 text-white backdrop-blur-xs">
                    {project.category}
                  </span>
                </div>

                <div class="absolute bottom-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity">
                  <span class="p-2 bg-white text-neutral-950 rounded-xs shadow-md flex items-center justify-center">
                    <svg
                      class="w-4 h-4"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M7 17 17 7m0 0H7m10 0v10"
                      />
                    </svg>
                  </span>
                </div>

              </div>
            </a>

            <!-- Content -->
            <div class="p-5 flex-1 flex flex-col justify-between space-y-3">

              <div>
                <div class="flex items-center justify-between text-xs text-neutral-400 uppercase tracking-wider font-semibold mb-1">
                  <span>{project.location}</span>
                  <span>{project.year}</span>
                </div>

                <a
                  href={`/portfolio/${project.slug || project.id}`}
                  class="block focus:outline-none"
                >
                  <h3 class="text-lg font-bold font-display uppercase tracking-wide text-neutral-950 group-hover:text-neutral-700 transition-colors">
                    {project.title}
                  </h3>
                </a>

                <p class="text-xs text-neutral-500 line-clamp-2 mt-1">
                  {project.description}
                </p>
              </div>

              <div class="pt-3 border-t border-neutral-100 flex items-center justify-between text-xs text-neutral-600 font-medium">

                <span>
                  Lahan: {project.landArea || "-"}
                </span>

                <a
                  href={`/portfolio/${project.slug || project.id}`}
                  class="font-bold text-neutral-950 uppercase tracking-wider hover:underline"
                >
                  Detail Proyek →
                </a>

              </div>
            </div>

          </article>
        ))}
      </div>

      <!-- Empty State -->
      <div
        id="empty-state"
        class="hidden py-20 text-center space-y-4"
      >
        <p class="text-neutral-400 text-base">
          Tidak ada proyek yang sesuai dengan kriteria pencarian.
        </p>

        <button
          id="reset-filter"
          type="button"
          class="px-5 py-2.5 bg-neutral-900 text-white text-xs font-bold uppercase tracking-wider rounded-xs cursor-pointer"
        >
          Reset Filter
        </button>
      </div>

    </div>
  </div>
</Layout>

<script>
  // Bungkus seluruh kode di dalam event astro:page-load
  document.addEventListener("astro:page-load", () => {
    
    const searchInput = document.querySelector("#portfolio-search") as HTMLInputElement;
    
    // Safety check: Jika elemen tidak ada (berada di halaman lain), hentikan eksekusi script
    if (!searchInput) return; 

    const projectCards = Array.from(document.querySelectorAll(".project-card")) as HTMLElement[];
    const categoryButtons = Array.from(document.querySelectorAll(".portfolio-category")) as HTMLElement[];
    const projectCount = document.querySelector("#project-count") as HTMLElement;
    const projectsGrid = document.querySelector("#projects-grid") as HTMLElement;
    const emptyState = document.querySelector("#empty-state") as HTMLElement;
    const resetButton = document.querySelector("#reset-filter") as HTMLButtonElement;

    let selectedCategory = "KARYA PILIHAN";

    function filterProjects() {
      const search = searchInput.value.toLowerCase().trim();
      let visibleCount = 0;

      projectCards.forEach((card) => {
        const title = card.dataset.title?.toLowerCase() || "";
        const location = card.dataset.location?.toLowerCase() || "";
        const category = card.dataset.category?.toLowerCase() || "";
        const categories = card.dataset.categories?.toLowerCase() || "";
        const client = card.dataset.client?.toLowerCase() || "";

        const matchCategory =
          selectedCategory === "KARYA PILIHAN" ||
          categories.includes(selectedCategory.toLowerCase());

        const matchSearch =
          title.includes(search) ||
          location.includes(search) ||
          category.includes(search) ||
          client.includes(search);

        const show = matchCategory && matchSearch;

        card.classList.toggle("hidden", !show);

        if (show) {
          visibleCount++;
        }
      });

      if (projectCount) {
        projectCount.textContent = visibleCount.toString();
      }

      if (visibleCount === 0) {
        projectsGrid?.classList.add("hidden");
        emptyState?.classList.remove("hidden");
      } else {
        projectsGrid?.classList.remove("hidden");
        emptyState?.classList.add("hidden");
      }
    }

    // Attach Event Listeners
    categoryButtons.forEach((button) => {
      button.addEventListener("click", () => {
        selectedCategory = button.dataset.category || "KARYA PILIHAN";

        categoryButtons.forEach((item) => {
          item.classList.remove("text-neutral-950", "active");
          item.classList.add("text-neutral-500");

          const indicator = item.querySelector(".category-indicator");
          indicator?.classList.add("hidden");
          indicator?.classList.remove("block");
        });

        button.classList.remove("text-neutral-500");
        button.classList.add("text-neutral-950", "active");

        const indicator = button.querySelector(".category-indicator");
        indicator?.classList.remove("hidden");
        indicator?.classList.add("block");

        filterProjects();
      });
    });

    searchInput.addEventListener("input", filterProjects);

    if (resetButton) {
      resetButton.addEventListener("click", () => {
        selectedCategory = "KARYA PILIHAN";
        searchInput.value = "";

        categoryButtons.forEach((button) => {
          const isDefault = button.dataset.category === "KARYA PILIHAN";

          button.classList.toggle("text-neutral-950", isDefault);
          button.classList.toggle("text-neutral-500", !isDefault);

          const indicator = button.querySelector(".category-indicator");
          indicator?.classList.toggle("hidden", !isDefault);
          indicator?.classList.toggle("block", isDefault);
        });

        filterProjects();
      });
    }
  });
</script>