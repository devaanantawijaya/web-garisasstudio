---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 | Halaman Tidak Ditemukan">
  <main
    class="min-h-screen flex flex-col items-center justify-center text-center px-6"
  >
    <p class="text-9xl font-medium text-neutral-500 mb-3">404</p>

    <h1 class="text-4xl sm:text-5xl font-bold text-neutral-900 mb-4">
      Halaman Tidak Ditemukan
    </h1>

    <p class="text-neutral-500 max-w-md mb-8">
      Maaf, halaman yang kamu cari tidak tersedia atau sudah dipindahkan.
    </p>

    <a
      href="/"
      class="inline-flex items-center px-6 py-3 rounded-lg bg-neutral-900 text-white text-sm font-medium hover:bg-neutral-800 transition"
    >
      Kembali ke Home
    </a>
  </main>
</Layout>
