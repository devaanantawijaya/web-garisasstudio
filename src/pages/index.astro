---
import ConsultationSection from "../components/ConsultationSection.astro";
import KeunggulanSection from "../components/KeunggulanSection.astro";
import ProyekPilihan from "../components/ProyekPilihan.astro";
import TestimoniSection from "../components/TestimoniSection.astro";
import FaqSection from "../components/FaqSection.astro";
import { PROJECTS } from "../data/projects";
import Layout from "../layouts/Layout.astro";
import { HeroCarousel } from "../react-components/HeroCarousel";
import PricingSection from "../components/PricingSection.astro";
---

<Layout>
  <HeroCarousel projects={PROJECTS} client:load />
  <KeunggulanSection />
  <ProyekPilihan projects={PROJECTS} />
  <TestimoniSection />
  <PricingSection />
  <FaqSection />
  <ConsultationSection />
</Layout>
